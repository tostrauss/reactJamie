# ============================================================
# JAMIE Backend — Production Environment Variables
# Copy this to Railway's "Variables" tab (or your hosting env)
# ============================================================

# --- Database ---
# Railway provides this automatically when you add a Postgres plugin.
# Paste the value from: Railway project → Postgres → Connect → DATABASE_URL
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
SESSION_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# --- Server ---
PORT=5000
NODE_ENV=production

# --- Frontend URL (CORS) ---
# Your Vercel/Netlify URL, and optionally your custom domain (comma-separated)
# Example: https://jamie.vercel.app,https://getjamie.app
FRONTEND_URL=https://your-frontend.vercel.app

# --- Spotify OAuth ---
# Spotify Developer Dashboard → Your App → Settings
# Set redirect URI to: https://your-frontend.vercel.app/spotify/callback
SPOTIFY_CLIENT_ID=ee289f98590d4bf89f71a0c5873496c0
SPOTIFY_CLIENT_SECRET=REPLACE_WITH_YOUR_SECRET
SPOTIFY_REDIRECT_URI=https://your-frontend.vercel.app/spotify/callback

# --- Email (SMTP) ---
# Free options: Resend (resend.com) or Brevo (brevo.com)
# Resend: SMTP_HOST=smtp.resend.com, PORT=587, USER=resend, PASS=re_yourkey
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=re_REPLACE_WITH_YOUR_KEY
EMAIL_FROM=JAMIE <noreply@getjamie.app>

# --- Android TWA (fill in before Phase 2 / Play Store submission) ---
# Package name you chose in PWABuilder / Google Play Console
ANDROID_PACKAGE=com.yourname.jamie
# SHA-256 fingerprint from PWABuilder-generated keystore
ANDROID_SHA256=YOUR_SHA256_CERT_FINGERPRINT
