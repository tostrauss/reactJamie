# ============================================================
# JAMIE Backend — Production Environment Variables
# Copy values to Railway's "Variables" tab (or your hosting env)
# NEVER commit .env — this file is a template only
#
# NUR Backend-Variablen. Die Frontend-Build-Config ist eigenständig in
# frontend/.env.production committet (VITE_API_URL=/api, leerer VITE_SOCKET_URL =
# same-origin, Maps-/Google-/VAPID-Public-Keys) — auf Railway sind KEINE
# VITE_*-Variablen nötig (höchstens zum Überschreiben).
# ============================================================

# --- Database ---
# Railway provides this automatically when you add a Postgres plugin.
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Auth (REQUIRED) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS
# (SESSION_SECRET entfernt — wird vom Code nirgends gelesen. Nicht wieder aufnehmen.)

# --- Server ---
PORT=5000
NODE_ENV=production

# --- Frontend URL (CORS + email links) ---
# Comma-separated if you have multiple. Single-Service-Deploy: die App-Domain.
FRONTEND_URL=https://app.jamie-app.com

# --- Email — Resend (REQUIRED in production) ---
# Sign up at resend.com → API Keys → Create API Key
# IMPORTANT: verify your sender domain in Resend first
RESEND_API_KEY=re_REPLACE_WITH_YOUR_RESEND_KEY
EMAIL_FROM=JAMIE <noreply@yourdomain.com>

# --- Admin notifications ---
# Email address that receives report alerts (uses Resend via RESEND_API_KEY above)
ADMIN_EMAIL=admin@yourcompany.com

# --- Admin access ---
# Grant admin access by setting is_admin=true in the users table:
#   UPDATE users SET is_admin=true WHERE email='you@example.com';
# No env var required — admin auth is JWT-based RBAC.

# --- Spotify OAuth ---
# Get from developer.spotify.com → Your App → Settings
SPOTIFY_CLIENT_ID=REPLACE_WITH_YOUR_SPOTIFY_CLIENT_ID
SPOTIFY_CLIENT_SECRET=REPLACE_WITH_YOUR_SPOTIFY_CLIENT_SECRET
SPOTIFY_REDIRECT_URI=https://app.jamie-app.com/spotify/callback
# Optional: eigener Redirect für den nativen (Capacitor) Flow, falls abweichend:
# SPOTIFY_NATIVE_REDIRECT_URI=jamie://spotify/callback

# --- Google OAuth (REQUIRED for secure Google login) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID

# --- Stripe (REQUIRED if using boost purchases or Pro subscriptions) ---
# dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_live_REPLACE
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE
# Webhooks → Create two endpoints:
#   1. /api/boost/stripe/webhook  → events: payment_intent.succeeded
#   2. /api/subscription/stripe/webhook → events: customer.subscription.*
# Each endpoint has its own signing secret:
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_BOOST_WEBHOOK_SECRET
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=whsec_REPLACE_SUBSCRIPTION_WEBHOOK_SECRET

# --- Push Notifications — VAPID (OPTIONAL) ---
# Generate ONCE with: npx web-push generate-vapid-keys
# Store these permanently — changing them invalidates all existing subscriptions
VAPID_PUBLIC_KEY=REPLACE
VAPID_PRIVATE_KEY=REPLACE
VAPID_SUBJECT=mailto:admin@yourdomain.com

# --- Cloud Storage — Cloudflare R2 / AWS S3 (REQUIRED for image uploads in prod) ---
# Without this, uploads fall back to local disk (not suitable for production)
STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=REPLACE
STORAGE_SECRET_KEY=REPLACE
STORAGE_BUCKET=jamie-uploads
STORAGE_REGION=auto
STORAGE_PUBLIC_URL=https://pub-xxx.r2.dev

# --- Content Moderation (OPTIONAL — silently disabled if not set) ---
SIGHTENGINE_API_USER=REPLACE
SIGHTENGINE_API_SECRET=REPLACE
OPENAI_API_KEY=sk-proj-REPLACE

# --- Guest / Demo mode ---
# Set to "true" to allow unauthenticated demo access via the "Demo-Modus" button
ALLOW_GUEST_TOKEN=true

# --- Region / Geofencing (OPTIONAL — sinnvolle Defaults) ---
# Geofencing ist in Produktion AUTOMATISCH AN (nur GEOFENCING=false schaltet es aus).
# ALLOWED_COUNTRIES default = "AT,DE,CH". Für echtes "nur Österreich" auf AT setzen.
# ALLOWED_COUNTRIES=AT
# GEOFENCING=false

# --- Rate Limiting ---
# ⛔ DISABLE_RATE_LIMIT in Produktion NICHT setzen (deaktiviert den Brute-Force-Schutz).
# Nur für lokale Lasttests. Standardmäßig weglassen.

# --- Sonstiges (OPTIONAL) ---
# Zusätzlicher CSP-connect-src-Origin, falls Socket/Frontend doch getrennt liegen
# (beim Single-Service-Deploy NICHT nötig):
# SOCKET_CSP_ORIGIN=https://app.jamie-app.com

# --- Error Monitoring — Sentry (OPTIONAL) ---
SENTRY_DSN=https://...@...ingest.sentry.io/...

# --- Redis (OPTIONAL — required for multi-instance horizontal scaling) ---
# Without this: rate limiting and Socket.IO are per-instance only
REDIS_URL=redis://default:password@host:6379

# --- Android TWA / Play Store ---
ANDROID_PACKAGE=jamie.app
ANDROID_SHA256=REPLACE_WITH_SHA256_FROM_KEYSTORE
ANDROID_SHA256_PLAY=REPLACE_WITH_SHA256_FROM_PLAY_CONSOLE

# --- Apple / iOS (Identität) ---
# Hinweis: APPLE_TEAM_ID / APPLE_BUNDLE_ID werden vom Backend NICHT zur Laufzeit
# gelesen — sie betreffen .well-known/apple-app-site-association + den nativen
# Build. Hier nur zur Vollständigkeit.
APPLE_TEAM_ID=REPLACE_10_CHAR_TEAM_ID
APPLE_BUNDLE_ID=jamie.app

# --- iOS Push (APNs) — alle 4 nötig, sonst no-op (Web-Push läuft unabhängig) ---
# developer.apple.com → Keys (.p8) bzw. Membership (Team ID). Erst nach Apple-Freigabe.
APNS_KEY_ID=REPLACE_10_CHAR_KEY_ID
APNS_TEAM_ID=REPLACE_10_CHAR_TEAM_ID
APNS_BUNDLE_ID=jamie.app
# Voller Inhalt der AuthKey_XXXXXXXXXX.p8 als EINE Zeile (\n-Escapes werden zu Zeilenumbrüchen):
APNS_KEY=REPLACE_WITH_P8_CONTENTS

# --- iOS In-App-Käufe (App Store Server API) ---
# ⚠️ Derzeit Stub/nicht funktionsfähig (siehe Memory) — erst zum iOS-Launch füllen.
APPLE_IAP_ENVIRONMENT=Sandbox
APPLE_IAP_BUNDLE_ID=jamie.app
APPLE_IAP_ISSUER_ID=REPLACE_ISSUER_UUID
APPLE_IAP_KEY_ID=REPLACE_KEY_ID
APPLE_IAP_PRIVATE_KEY=REPLACE_WITH_P8_CONTENTS

# --- Verschlüsseltes DB-Backup → R2-Tresor (siehe BACKUP-KONZEPT.md) ---
# Diese Variablen gehören als GitHub-Actions-Secrets hinterlegt (nicht in Railway).
# Der Backup-Lauf nutzt ein SEPARATES Cloudflare-Konto mit 2FA + Object Lock.
# AES-256-Passphrase für die Dumps — NUR im Passwort-Manager, niemals im Backup-Konto:
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_LONG_RANDOM_PASSPHRASE
# R2-Tresor (Backup-Konto, NICHT der Live-Uploads-Bucket):
BACKUP_S3_BUCKET=jamie-backups
BACKUP_S3_ENDPOINT=https://<backup_account_id>.r2.cloudflarestorage.com
# R2-Token mit NUR PutObject-Recht (kann Backups weder löschen noch überschreiben):
BACKUP_S3_ACCESS_KEY=REPLACE
BACKUP_S3_SECRET_KEY=REPLACE
# Optional: Mindestgröße des Dumps in Bytes (Default 10240); bei großer DB erhöhen.
# BACKUP_MIN_BYTES=10240
