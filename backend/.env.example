DB_HOST=localhost
DB_PORT=5432
DB_NAME=jamie_db
DB_USER=postgres
DB_PASSWORD=your_password
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_key_here
PORT=5000
NODE_ENV=development
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
# Must point at the FRONTEND callback route (page: SpotifyCallback.jsx) and be
# registered VERBATIM in the Spotify dashboard → Redirect URIs.
#   local dev : http://localhost:5173/spotify/callback   (your Vite port)
#   production: https://app.jamie-app.com/spotify/callback
# If unset, the backend falls back to `${FRONTEND_URL}/spotify/callback`.
SPOTIFY_REDIRECT_URI=http://localhost:5173/spotify/callback

# Email — Resend HTTP API (https://resend.com)
# REQUIRED in production. Create an API key in Resend dashboard → API Keys.
# Then verify your sending domain (DNS records) or all emails will be rejected.
RESEND_API_KEY=re_...
EMAIL_FROM=JAMIE <noreply@jamie-app.com>
FRONTEND_URL=http://localhost:5173

# Cloud Storage (Cloudflare R2 or AWS S3)
# Leave empty in development — uploads fall back to local /uploads directory
# R2 example: STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# AWS example: STORAGE_ENDPOINT=https://s3.<region>.amazonaws.com
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=jamie-uploads
STORAGE_REGION=auto
# Public URL for your bucket (R2 public URL or CloudFront CDN URL)
STORAGE_PUBLIC_URL=

# Android TWA — Play Store
# Package name (must match twa/twa-manifest.json)
ANDROID_PACKAGE=jamie.app
# SHA-256 fingerprint from your keystore (run twa/2-get-sha256.sh)
ANDROID_SHA256=
# SHA-256 from Play App Signing (Play Console → Setup → App Signing → "App signing key certificate")
ANDROID_SHA256_PLAY=

# Admin / Moderation
# Email address that receives report notifications
ADMIN_EMAIL=
# Admin dashboard: grant access by setting is_admin=true in the users table for the user's row.
# Example: UPDATE users SET is_admin=true WHERE email='you@example.com';
# ADMIN_SECRET is no longer used — admin auth is JWT-based RBAC.

# Geofencing (server-side, production only)
# Comma-separated ISO country codes where registration is allowed.
# CODE DEFAULT = AT,DE,CH,IT (middleware/geofence.js + utils/geocode.js) — leaving
# this UNSET is the normal production setup and is what keeps Italy enabled.
# Only set it to NARROW the markets; a stale value here silently drops a market.
# Keep in sync with frontend/src/utils/regions.js if you do set it.
# Set GEOFENCING=false to disable entirely (e.g. for staging)
ALLOWED_COUNTRIES=AT,DE,CH,IT
GEOFENCING=true

# Text Moderation (OpenAI — https://platform.openai.com)
# Free moderation endpoint — no token cost per call
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Image Moderation (Sightengine — https://sightengine.com)
# Leave empty in development — moderation is skipped automatically
# Get credentials at: https://dashboard.sightengine.com/api-credentials
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Web Push Notifications (VAPID)
# Generate keys once: node backend/scripts/generate-vapid-keys.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@jamie-app.com

# iOS Universal Links (apple-app-site-association)
# APPLE_TEAM_ID: 10-char string from developer.apple.com → Membership
# APPLE_BUNDLE_ID: must match appId in capacitor.config.json
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=jamie.app

# Stripe (Apple Pay + cards)
# Get from dashboard.stripe.com → Developers → API keys
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
# Webhook secret for boost/one-time purchases (dashboard.stripe.com → Webhooks → your endpoint → Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook secret for SUBSCRIPTION events — use a SEPARATE webhook endpoint targeting /api/subscription/stripe/webhook
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=whsec_...
# Stripe Tax on Pro subscriptions (IMPIBAG is USt-pflichtig). Only the literal
# 'true' enables it. Prices stay GROSS (tax_behavior=inclusive): the customer
# always pays the advertised 1,99/4,99/19,99 €, and the VAT is carved OUT of
# that amount — turning this on or off never changes what anyone is charged.
# Requires in the Stripe dashboard: Stripe Tax active + an AT tax registration.
# If Stripe cannot resolve a customer's location the subscription is created
# WITHOUT tax rather than failing (logged to Sentry as 'tax-fallback').
# Separate from the payment kill switch on purpose — can be flipped off alone.
STRIPE_TAX_ENABLED=false
# Countries JAMIE Pro may be SOLD in — deliberately narrower than the countries
# the app is available in (ALLOWED_COUNTRIES: AT,DE,CH,IT,FR,ES). Every country
# we take money in is a country we may owe VAT in, so the paid product is
# limited to the one tax registration we hold. German buyers are still charged
# Austrian VAT (under the 10k EUR EU-wide B2C threshold). Enforced server-side
# on /subscription/create via GeoIP; unknown countries are ALLOWED (a geoip gap
# must not kill sales). Widen ONLY after the matching tax registration exists.
SUBSCRIPTION_COUNTRIES=AT,DE

# ── Offsite backup vault (cyber-insurance obligation — BACKUP-KONZEPT.md) ──
# R2 bucket in a SEPARATE Cloudflare account (own login + own 2FA — NEVER the
# production account that holds STORAGE_*). Bucket must be created WITH
# Object Lock + 30d COMPLIANCE default retention (BACKUP-SETUP-ANLEITUNG.md).
# All 5 set → nightly encrypted pg_dump (03:15 UTC) + weekly media sync arm
# themselves; any missing → backup stays off (one startup log line, no errors).
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_BUCKET=jamie-backups
# AES-256 passphrase for the dumps. Store ONLY in the password manager + sealed
# envelope — NEVER in the backup Cloudflare account. Key loss = backup loss!
BACKUP_ENCRYPTION_KEY=
# Optional overrides (defaults in src/jobs/backup.js):
# BACKUP_R2_ENDPOINT=          # default https://<BACKUP_R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# BACKUP_RETENTION_DAYS=30     # WORM window asserted per upload (Konzept §3/§5)
# BACKUP_PRUNE_AFTER_DAYS=37   # safety-net prune; primary deletion = bucket lifecycle rule
# BACKUP_MIN_BYTES=10240       # refuse to upload dumps smaller than this (empty-dump guard)
# BACKUP_MEDIA_SYNC=false      # set to disable the weekly media replication

# How many reverse-proxy hops sit in front of the app (Express `trust proxy`).
# Every per-IP rate limiter keys on req.ip, which is the XFF entry that many
# hops from the right. On Railway there are TWO (public edge + internal), so
# with the default 1 every user shares the EDGE address -> one global bucket
# (verified 2026-09-04 via /api/admin/ip-diagnostics: reqIp = edge, clientIp =
# user). Set to 2 on Railway. Re-check: reqIp must equal clientIp afterwards.
# Never re-key the limiters on the leftmost XFF instead - that is spoofable.
TRUST_PROXY_HOPS=2
