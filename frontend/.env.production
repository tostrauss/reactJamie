# ============================================================
# JAMIE Frontend — Production Environment Variables
# Set these in Vercel: Project Settings → Environment Variables
# ============================================================

# Your Railway backend URL (no trailing slash)
# Example: https://jamie-backend-production.up.railway.app
VITE_API_URL=https://reactjamie-production.up.railway.app/api

# Same Railway backend URL — used by Socket.io client
VITE_SOCKET_URL=https://reactjamie-production.up.railway.app

