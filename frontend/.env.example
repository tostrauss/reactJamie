# ============================================================
# JAMIE Frontend — Environment Variables
# Copy to frontend/.env.local for local dev
# Set in Railway / Vercel build environment for production
# ============================================================

# --- API & Socket ---
# Local dev: leave as /api (Vite proxies to backend)
# Production (separate deploy): set to https://your-backend.railway.app/api
VITE_API_URL=/api

# Production socket URL — leave empty if frontend and backend are on the same domain
# Set to https://your-backend.railway.app if deployed separately
VITE_SOCKET_URL=

# --- Google OAuth (OPTIONAL — enables "Sign in with Google" button) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Add your frontend domain as an Authorized JavaScript origin
VITE_GOOGLE_CLIENT_ID=

# --- Google Maps (REQUIRED for Karte / map tab) ---
# Google Cloud Console → APIs & Services → Enable "Maps JavaScript API"
# Restrict key to your domain via HTTP Referrers
VITE_GOOGLE_MAPS_API_KEY=

# --- Push Notifications — VAPID public key (OPTIONAL) ---
# Must match VAPID_PUBLIC_KEY set on the backend
# Generate ONCE with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# --- Error Monitoring — Sentry (OPTIONAL) ---
# sentry.io → Project → Settings → Client Keys (DSN)
VITE_SENTRY_DSN=

# --- Stripe publishable key (OPTIONAL — required for card/Apple Pay payments) ---
# dashboard.stripe.com → Developers → API keys
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
