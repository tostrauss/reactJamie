# ============================================================
# JAMIE — Environment Variables Reference
# Copy to .env and fill in values. Never commit .env
# ============================================================

# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────
# Railway: use ${{Postgres.DATABASE_URL}} reference
DATABASE_URL=postgresql://user:password@localhost:5432/jamie_db

# ── Auth (REQUIRED — generate with: node -e "require('crypto').randomBytes(64).toString('hex')|console.log")
SESSION_SECRET=CHANGE_ME_use_node_crypto_randomBytes_64
JWT_SECRET=CHANGE_ME_use_node_crypto_randomBytes_64

# ── Email — Resend HTTP API (REQUIRED in production) ──────
# Sign up at resend.com → API Keys → Create
# Then add and verify your sending domain in Resend dashboard.
RESEND_API_KEY=re_...
EMAIL_FROM=JAMIE <noreply@jamie-app.com>

# ── Frontend URL (REQUIRED — used in email links and CORS) ─
FRONTEND_URL=http://localhost:3000

# ── Redis (OPTIONAL — required for multi-instance scaling) ─
# Without this: Socket.IO and rate limiting are single-instance only
REDIS_URL=redis://localhost:6379

# ── Stripe (OPTIONAL — boost purchases and subscriptions) ──
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=whsec_...

# ── Spotify (OPTIONAL — song picker and profile) ──────────
SPOTIFY_CLIENT_ID=...
SPOTIFY_CLIENT_SECRET=...
SPOTIFY_REDIRECT_URI=https://your-domain.com/spotify/callback

# ── Google OAuth (OPTIONAL — improves security of Google login)
GOOGLE_CLIENT_ID=...

# ── Google Maps (REQUIRED for Karte tab) ──────────────────────
# Enable "Maps JavaScript API" in Google Cloud Console, then create a key
VITE_GOOGLE_MAPS_API_KEY=...

# ── Push Notifications — VAPID (OPTIONAL) ─────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:you@example.com

# ── Cloud Storage — Cloudflare R2 / AWS S3 (OPTIONAL) ─────
# Without this: uploads are stored locally (dev only)
STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=...
STORAGE_SECRET_KEY=...
STORAGE_BUCKET=jamie-uploads
STORAGE_REGION=auto
STORAGE_PUBLIC_URL=https://pub-xxx.r2.dev

# ── Content Moderation (OPTIONAL) ─────────────────────────
SIGHTENGINE_API_USER=...
SIGHTENGINE_API_SECRET=...
OPENAI_API_KEY=sk-proj-...

# ── Admin (OPTIONAL) ──────────────────────────────────────
# Admin access is granted per-user via DB column:
#   UPDATE users SET is_admin=true WHERE email='you@yourcompany.com';
# ADMIN_SECRET is no longer used (legacy).
ADMIN_EMAIL=admin@jamie-app.com

# ── Error Monitoring — Sentry (OPTIONAL) ──────────────────
SENTRY_DSN=https://...@...ingest.sentry.io/...
# Frontend DSN (baked into Docker build — set in Railway build vars too)
VITE_SENTRY_DSN=https://...@...ingest.sentry.io/...
# For source map uploads during CI builds:
# SENTRY_AUTH_TOKEN=...
# SENTRY_ORG=your-org
# SENTRY_PROJECT=jamie-frontend

# ── Dev only ──────────────────────────────────────────────
# DISABLE_RATE_LIMIT=true
# ALLOW_GUEST_TOKEN=true

# ── Android (TWA / Play Store) ────────────────────────────
# ANDROID_SHA256=<from keytool -list -v on your keystore>
# ANDROID_SHA256_PLAY=<fingerprint from Google Play Console>
